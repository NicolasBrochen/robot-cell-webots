#VRML_SIM R2025a utf8
# Example 01: SCARA following a 3D figure-8 by inverse kinematics, the actual tool path drawn live in red
# (planned path in green). Controller: controllers/scara_trajectory.

WorldInfo {
  info [ "Robot SCARA 4 axes (RRPR) avec trace de trajectoire" ]
  title "SCARA"
  basicTimeStep 16
}
Viewpoint {
  orientation -0.2 -0.05 0.98 3.6
  position 1.6 0.9 1.1
}
Background {
  skyColor [ 0.75 0.82 0.9 ]
}
DirectionalLight {
  direction -0.4 -0.6 -1
  intensity 2
  castShadows TRUE
}
PointLight {
  location 0.5 0.5 1.5
  intensity 0.6
  attenuation 0 0 1
}
Solid {
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.55 0.57 0.6 roughness 0.8 metalness 0 }
      geometry Box { size 3 3 0.02 }
    }
  ]
  name "sol"
  translation 0 0 -0.01
  boundingObject Box { size 3 3 0.02 }
}
DEF WORKTABLE Solid {
  translation 0.45 0 0.025
  children [
    Shape {
      appearance PBRAppearance { baseColor 0.85 0.85 0.8 roughness 0.6 metalness 0 }
      geometry Box { size 0.5 0.5 0.05 }
    }
  ]
  name "plan de travail"
  boundingObject Box { size 0.5 0.5 0.05 }
}
DEF PLANNED_PATH Shape {
  appearance Appearance {
    material Material { diffuseColor 0 0 0 emissiveColor 0.1 0.8 0.2 }
  }
  geometry IndexedLineSet {
    coord Coordinate { point [ 0 0 0 ] }
    coordIndex [ 0 0 ]
  }
}
DEF TRAIL Shape {
  appearance Appearance {
    material Material { diffuseColor 0 0 0 emissiveColor 1 0.1 0.1 }
  }
  geometry IndexedLineSet {
    coord Coordinate { point [ 0 0 0 ] }
    coordIndex [ 0 0 ]
  }
}
DEF SCARA Robot {
  name "scara"
  controller "scara_trajectory"
  supervisor TRUE
  children [
    # Socle + colonne
    Pose {
      translation 0 0 0.02
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.2 0.2 0.22 roughness 0.5 metalness 0.3 }
          geometry Cylinder { radius 0.16 height 0.04 }
        }
      ]
    }
    Pose {
      translation 0 0 0.21
      children [
        Shape {
          appearance PBRAppearance { baseColor 0.95 0.55 0.1 roughness 0.4 metalness 0.1 }
          geometry Cylinder { radius 0.09 height 0.38 }
        }
      ]
    }
    # Axe 1 : épaule (rotation Z)
    HingeJoint {
      jointParameters HingeJointParameters { axis 0 0 1 anchor 0 0 0.4 }
      device [
        RotationalMotor { name "joint1" maxVelocity 4 minPosition -2.6 maxPosition 2.6 }
        PositionSensor { name "joint1_sensor" }
      ]
      endPoint Solid {
        name "bras1"
        translation 0 0 0.4
        children [
          Pose {
            translation 0 0 0.03
            children [
              Shape {
                appearance DEF ORANGE PBRAppearance { baseColor 0.95 0.55 0.1 roughness 0.4 metalness 0.1 }
                geometry Cylinder { radius 0.09 height 0.06 }
              }
            ]
          }
          Pose {
            translation 0.2 0 0.03
            children [
              Shape { appearance USE ORANGE geometry Box { size 0.4 0.12 0.06 } }
            ]
          }
          Pose {
            translation 0.4 0 0.03
            children [
              Shape { appearance USE ORANGE geometry Cylinder { radius 0.06 height 0.06 } }
            ]
          }
          # Axe 2 : coude (rotation Z)
          HingeJoint {
            jointParameters HingeJointParameters { axis 0 0 1 anchor 0.4 0 0.06 }
            device [
              RotationalMotor { name "joint2" maxVelocity 5 minPosition -2.6 maxPosition 2.6 }
              PositionSensor { name "joint2_sensor" }
            ]
            endPoint Solid {
              name "bras2"
              translation 0.4 0 0.06
              children [
                Pose {
                  translation 0 0 0.025
                  children [
                    Shape {
                      appearance DEF GREY PBRAppearance { baseColor 0.85 0.85 0.88 roughness 0.3 metalness 0.2 }
                      geometry Cylinder { radius 0.055 height 0.05 }
                    }
                  ]
                }
                Pose {
                  translation 0.15 0 0.025
                  children [
                    Shape { appearance USE GREY geometry Box { size 0.3 0.1 0.05 } }
                  ]
                }
                Pose {
                  translation 0.3 0 0.035
                  children [
                    Shape { appearance USE GREY geometry Cylinder { radius 0.05 height 0.07 } }
                  ]
                }
                # Axe 3 : translation verticale (descend quand la position augmente)
                SliderJoint {
                  jointParameters JointParameters { axis 0 0 -1 }
                  device [
                    LinearMotor { name "joint3" maxVelocity 0.5 minPosition 0 maxPosition 0.15 }
                    PositionSensor { name "joint3_sensor" }
                  ]
                  endPoint Solid {
                    name "fourreau"
                    translation 0.3 0 0
                    children [
                      Pose {
                        translation 0 0 -0.05
                        children [
                          Shape {
                            appearance PBRAppearance { baseColor 0.7 0.72 0.75 roughness 0.15 metalness 0.9 }
                            geometry Cylinder { radius 0.018 height 0.36 }
                          }
                        ]
                      }
                      # Axe 4 : rotation de l'outil
                      HingeJoint {
                        jointParameters HingeJointParameters { axis 0 0 1 anchor 0 0 -0.23 }
                        device [
                          RotationalMotor { name "joint4" maxVelocity 6 }
                          PositionSensor { name "joint4_sensor" }
                        ]
                        endPoint DEF TOOL Solid {
                          name "outil"
                          translation 0 0 -0.25
                          children [
                            Shape {
                              appearance PBRAppearance { baseColor 0.15 0.15 0.15 roughness 0.5 metalness 0.2 }
                              geometry Box { size 0.08 0.03 0.03 }
                            }
                            Pose {
                              translation 0.03 0 -0.03
                              children [
                                Shape {
                                  appearance DEF RED PBRAppearance { baseColor 0.8 0.1 0.1 roughness 0.5 metalness 0 }
                                  geometry Box { size 0.012 0.025 0.04 }
                                }
                              ]
                            }
                            Pose {
                              translation -0.03 0 -0.03
                              children [
                                Shape { appearance USE RED geometry Box { size 0.012 0.025 0.04 } }
                              ]
                            }
                          ]
                        }
                      }
                    ]
                  }
                }
              ]
            }
          }
        ]
      }
    }
  ]
}
